{
  "name": "BB Command Center",
  "short_name": "BB Command",
  "description": "Private owner dashboard for project status, priorities, approvals, schedules, and execution.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#020406",
  "theme_color": "#020406",
  "icons": [
    {
      "src": "cc/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "cc/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/bb-command-center-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ]
}