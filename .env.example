# Chill Bros server-only configuration template.
# Keep real credentials in Vercel Environment Variables only. Never paste
# service-role, payment, SMTP, or other secrets into source control or chat.

# Supabase. Use the dedicated Chill Bros project when isolation is completed.
# Do not put production values in this example file: local clones should not
# silently connect to production infrastructure.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for a future direct card / Apple Pay integration. The current app
# does not contain Stripe charge/refund/transfer code.
STRIPE_SECRET_KEY=

# Reserved for outbound quote/approval/receipt email. Use a provider-specific
# app password/token, never the mailbox's normal login password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Scan & Send. These power the signed-in /scan-send paperwork tool.
# RESEND_API_KEY is secret and must stay server-side.
RESEND_API_KEY=
SCAN_FROM_EMAIL=
# Optional default destination shown in the Scan & Send form.
SCAN_DEFAULT_TO=
# Optional comma-separated allowlist. Leave blank to permit any recipient.
SCAN_ALLOWED_RECIPIENTS=
