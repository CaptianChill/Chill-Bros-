{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/p/:token", "destination": "/portal" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/owner", "permanent": false },
    { "source": "/", "destination": "/vperformance", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/(owner|portal|p/.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
  ]
}
